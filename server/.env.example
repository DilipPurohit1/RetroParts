# RetroParts Full-Stack Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local instance; defaults to MongoMemoryServer if omitted)
# MONGODB_URI=mongodb://localhost:27017/retroparts

# JWT Authentication Secrets
JWT_ACCESS_SECRET=retroparts_access_secret_key_min_32_chars_jwt_auth_production_secure
JWT_REFRESH_SECRET=retroparts_refresh_secret_key_min_32_chars_jwt_auth_production_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Media Storage (For listing part photos)
CLOUDINARY_CLOUD_NAME=retroparts-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=mock_cloudinary_api_secret

# URLs & CORS Allow-List
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
