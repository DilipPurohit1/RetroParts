# RetroParts Full-Stack Environment Configuration
# Copy this file to server/.env and adjust values for your environment.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local instance; defaults to MongoMemoryServer if omitted)
MONGODB_URI=mongodb://localhost:27017/retroparts

# JWT Authentication Secrets
JWT_ACCESS_SECRET=retroparts_access_secret_key_min_32_chars_jwt_auth
JWT_REFRESH_SECRET=retroparts_refresh_secret_key_min_32_chars_jwt_auth
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_from_gcp_console.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_from_gcp_console
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Media Storage (For listing part photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# URLs & CORS Allow-List
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
